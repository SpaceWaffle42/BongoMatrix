[Unit]
Description=Fixed physical Matrix CI verifier
Requires=systemd-tmpfiles-setup.service
After=matrix-web.service systemd-tmpfiles-setup.service
Conflicts=shutdown.target

[Service]
Type=exec
User=root
Group=root
RuntimeDirectory=matrix-ci-physical
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=90
TimeoutStopSec=75
RuntimeMaxSec=90
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/matrix-ci-physical-verifier
ExecStop=/usr/bin/python3 -I -B /usr/local/libexec/matrix-ci-physical-verifier --restore-only
ExecStopPost=/usr/bin/python3 -I -B /usr/local/libexec/matrix-ci-physical-verifier --restore-only --scavenge-stale-temporaries
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_DAC_READ_SEARCH
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/run/matrix-display
ReadWritePaths=/run/matrix-ci-physical
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET

# Deliberately not enabled: the enabled path unit is the sole admission trigger.
