[Unit]
Description=Matrix first-run Wi-Fi hotspot and setup portal
Wants=NetworkManager.service
After=NetworkManager.service
Before=matrix-web.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
WorkingDirectory=/home/admin/matrix
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/admin/matrix/venv/bin/python /home/admin/matrix/setup/first_run.py
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/NetworkManager/dnsmasq-shared.d
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
