[Unit]
Description=Bongo Matrix v3 display
# Not network-online.target: that holds start-up until an address arrives (up to a minute or two
# with no Wi-Fi, which is exactly when the panel must show the setup hotspot). The display copes
# with no network and picks it up when it comes.
After=network.target

[Service]
# Root is needed for GPIO access by rgbmatrix.
User=root
# The display says READY=1 once its panel is up and WATCHDOG=1 every 5 s while its player is alive
# (bongo/sdnotify.py, Live.watch): a process that hangs as a whole is restarted. A stuck player is
# ended by the display itself after 180 s (Live.FROZEN_SECONDS). A Pi Zero takes a while to start.
Type=notify
NotifyAccess=main
WatchdogSec=60
TimeoutStartSec=180
WorkingDirectory=/home/admin/matrix
ExecStart=/home/admin/matrix/venv/bin/python -m bongo run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=/home/admin/matrix/data
PrivateTmp=true
# room for imported modules' connections through their gate (bongo/sandbox/gate.py)
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
