[Unit]
Description=Matrix display and LAN control panel
Requires=matrix-network-setup.service
After=network-online.target matrix-network-setup.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/admin/matrix
Environment=PYTHONUNBUFFERED=1
Environment=MATRIX_HOST=0.0.0.0
Environment=MATRIX_PORT=5000
Environment=MATRIX_LOCK_FILE=/run/matrix-display/matrix-display.lock
Environment=MATRIX_SANITIZER_PATH=/run/matrix-display/media_sanitizer.py
Environment=MATRIX_SANITIZER_PYTHON=/usr/bin/python3
Environment=MATRIX_DEVICE_RESTART_ENABLED=1
RuntimeDirectory=matrix-display
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/install -m 0644 -o root -g root /home/admin/matrix/media_sanitizer.py /run/matrix-display/media_sanitizer.py
ExecStart=/home/admin/matrix/venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - app.wsgi:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/matrix/data /home/admin/matrix/resources/media
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
