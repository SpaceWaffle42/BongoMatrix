[Unit]
Description=Matrix display and LAN control panel
Requires=matrix-network-setup.service systemd-tmpfiles-setup.service
After=network-online.target matrix-network-setup.service systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=simple
User=matrix-web
Group=matrix-web
WorkingDirectory=/home/admin/matrix
Environment=PYTHONUNBUFFERED=1
Environment=MATRIX_HOST=0.0.0.0
Environment=MATRIX_PORT=5000
Environment=MATRIX_LOCK_FILE=/run/matrix-display/matrix-display.lock
Environment=MATRIX_SANITIZER_PATH=/home/admin/matrix/media_sanitizer.py
Environment=MATRIX_SANITIZER_PYTHON=/usr/bin/python3
Environment=MATRIX_DEVICE_RESTART_ENABLED=1
ExecStart=/home/admin/matrix/venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - app.wsgi:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_RAWIO
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=/run/systemd/private /run/dbus/system_bus_socket
InaccessiblePaths=/run/matrix-ci-physical
ReadOnlyPaths=/run/matrix-display
ReadWritePaths=/home/admin/matrix/data /home/admin/matrix/resources/media /run/matrix-device-restart
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DevicePolicy=closed
DeviceAllow=/dev/mem rw
DeviceAllow=/dev/gpiomem rw
DeviceAllow=/dev/vcio rw

[Install]
WantedBy=multi-user.target
